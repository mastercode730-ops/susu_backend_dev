# Copy to .env and fill in. Never commit the real .env.

# ── Database (dev) ──
DB_SERVER=your-sql-server-host
DB_DATABASE=SUSU9DB_DEV
DB_USER=your-db-user
DB_PASSWORD=your-db-password
DB_PORT=1433

# ── JWT ── generate a fresh secret for this deployment, e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d
# Super Manager sessions are shorter by default.
SM_JWT_EXPIRES_IN=1d

PORT=3000

# ── Subscription model ──
# Open "New User? Register" signup bypasses payment, so it is off by default.
ALLOW_SELF_REGISTER=false
# Optional: JSON POST on every new payment submission (Slack/Discord/n8n/WhatsApp gateway).
SM_NOTIFY_WEBHOOK_URL=
